DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

JWT_SECRET="your-jwt-secret"
ADMIN_JWT_SECRET="your-admin-jwt-secret"
ADMIN_OPEN_REGISTRATION="true"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google SMTP for artist email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
# App password from https://myaccount.google.com/apppasswords (no spaces)
SMTP_PASS=your16charapppassword
SMTP_FROM="Vibra <your-email@gmail.com>"

CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# RapidAPI Spotify catalog (spotify23). The hyphenated name matches the RapidAPI header.
SPOTIFYMUSIC_API_X-RapidAPI_Key=""
# Host only, for example spotify23.p.rapidapi.com
Gateway_URL="https://spotify23.p.rapidapi.com"

# Audius read API. Stream URLs come from this host.
AUDIUS_API_URL="https://api.audius.co/v1"

# Free client id from https://devportal.jamendo.com/ (used only to stream, not download).
JAMENDO_CLIENT_ID=""

