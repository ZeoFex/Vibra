generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserTier {
  free
  premium
}

enum AdminRole {
  super_admin
  content_manager
  verification_manager
  support_admin
  finance_admin
}

enum ArtistStatus {
  pending
  active
  suspended
}

enum UploadStatus {
  pending
  published
  rejected
  draft
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  name          String
  username      String?  @unique
  avatarUrl     String?  @map("avatar_url")
  bio           String?
  preferences   Json?
  tier          UserTier @default(free)
  emailVerified Boolean  @default(true) @map("email_verified")
  verifyToken   String?  @map("verify_token")
  verifyExpires DateTime? @map("verify_expires")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  sentRequests     FriendRequest[] @relation("FriendRequestFrom")
  receivedRequests FriendRequest[] @relation("FriendRequestTo")
  sentMessages     DirectMessage[] @relation("MessageFrom")
  receivedMessages DirectMessage[] @relation("MessageTo")
  communityMessages CommunityMessage[]
  notifications     AppNotification[]
  voiceNotes        VoiceNote[]
  listens           Listen[]

  @@map("users")
}

model Listen {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId     String   @map("song_id")
  title      String
  artistName String   @map("artist_name")
  cover      String   @default("")
  plays      Int      @default(1)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, songId])
  @@index([userId])
  @@map("listens")
}

model VoiceNote {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  audioUrl  String   @map("audio_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("voice_notes")
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         AdminRole @default(support_admin)
  avatarUrl    String?   @map("avatar_url")
  createdById  String?   @map("created_by_id")
  createdBy    Admin?    @relation("AdminHierarchy", fields: [createdById], references: [id])
  subAdmins    Admin[]   @relation("AdminHierarchy")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admins")
}

model Artist {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String       @map("password_hash")
  stageName     String       @map("stage_name")
  legalName     String       @map("legal_name")
  genre         String
  country       String
  bio           String?
  imageUrl      String?      @map("image_url")
  status        ArtistStatus @default(pending)
  emailVerified Boolean      @default(false) @map("email_verified")
  verifyToken   String?      @map("verify_token")
  verifyExpires DateTime?    @map("verify_expires")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  uploads       ArtistUpload[]

  @@map("artists")
}

model ArtistUpload {
  id                 String       @id @default(uuid())
  artistId           String       @map("artist_id")
  artist             Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title              String
  artistName         String       @map("artist_name")
  albumTitle         String       @map("album_title")
  releaseType        String?      @map("release_type")
  albumGroupId       String?      @map("album_group_id")
  trackNumber        Int?         @map("track_number")
  genre              String
  about              String?
  producers          String
  songwriters        String?
  featuredArtists    String?      @map("featured_artists")
  lyrics             String?
  coverUrl           String       @map("cover_url")
  audioFileName      String       @map("audio_file_name")
  audioUrl           String?      @map("audio_url")
  duration           Int          @default(180)
  releaseDate        DateTime     @map("release_date")
  explicit           Boolean      @default(false)
  copyrightConfirmed Boolean      @default(false) @map("copyright_confirmed")
  status             UploadStatus @default(pending)
  submittedAt        DateTime     @default(now()) @map("submitted_at")
  audio              ArtistUploadAudio?

  @@map("artist_uploads")
}

model ArtistUploadAudio {
  uploadId  String       @id @map("upload_id")
  upload    ArtistUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String       @map("mime_type")
  sizeBytes Int          @map("size_bytes")
  storage   String       @default("database")
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("artist_upload_audio")
}

enum FriendRequestStatus {
  pending
  accepted
  declined
}

model FriendRequest {
  id          String              @id @default(uuid())
  fromId      String              @map("from_id")
  toId        String              @map("to_id")
  from        User                @relation("FriendRequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to          User                @relation("FriendRequestTo", fields: [toId], references: [id], onDelete: Cascade)
  status      FriendRequestStatus @default(pending)
  createdAt   DateTime            @default(now()) @map("created_at")

  @@unique([fromId, toId])
  @@map("friend_requests")
}

model DirectMessage {
  id          String   @id @default(uuid())
  senderId    String   @map("sender_id")
  recipientId String   @map("recipient_id")
  sender      User     @relation("MessageFrom", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("MessageTo", fields: [recipientId], references: [id], onDelete: Cascade)
  content     String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([senderId, recipientId])
  @@map("direct_messages")
}

model AppNotification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("app_notifications")
}

model CommunityMessage {
  id        String   @id @default(uuid())
  senderId  String   @map("sender_id")
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("community_messages")
}
